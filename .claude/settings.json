{
  "permissions": {
    "allow": [
      "Bash(rtk git *)",
      "Bash(rtk ls *)",
      "Bash(rtk grep *)",
      "Bash(rtk wc *)",
      "Bash(make test*)",
      "Bash(make lint)",
      "Bash(make check-schema)",
      "Bash(make check-privacy)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(node tools/check_privacy.mjs*)",
      "Bash(node tools/check_schema_drift.mjs*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-privacy.mjs"
          }
        ]
      }
    ]
  }
}
