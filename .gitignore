.cursor
*.db
*.tar
__pycache__
logs/
db/
screenshots/

# Per-user secrets & config. The repo ships ONLY *.example templates; each user
# copies them to the real filename (which stays gitignored), so no personal data
# — resume, target companies, API keys, chat id — is ever committed/pushed.
apps/worker/.env
apps/worker/.venv
apps/worker/config.yaml
# Ignore the CONTENTS of resume/ (not the dir itself, so the re-includes below
# work — a dir-level ignore would suppress them).
apps/worker/resume/*
!apps/worker/resume/README.md
!apps/worker/resume/resume.txt.example

# Orphaned tailored-PDF output dir (tailoring removed; kept ignored so any
# leftover personal PDFs are never committed).
resumes/

# Fit-score eval: the golden labels + run outputs reference real postings (by DB
# id) + real resume/profile context, so the DATA stays gitignored; the harness
# SCRIPT lives in apps/worker/tools/ and IS committed.
apps/worker/eval/
