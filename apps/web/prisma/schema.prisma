generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Configurable so the same schema works in two places:
  //   - local dev / Prisma CLI: `file:./applications.db` (see .env) → the
  //     prisma/applications.db symlink to ../db/applications.db.
  //   - Docker: an absolute path on a DIRECTORY-mounted volume shared with the
  //     Python worker, e.g. `file:/data/applications.db`. The directory mount
  //     (not a single-file mount) is REQUIRED so SQLite's WAL -wal/-shm sidecar
  //     files are visible to both processes; otherwise cross-container WAL breaks.
  url      = env("DATABASE_URL")
}

model applications {
  id              Int              @id @default(autoincrement())
  company_name    String
  job_title       String
  application_url String?
  date_applied    String
  category        String?
  status          String
  notes           String?
  last_updated    String?
  status_history  status_history[]
  job_postings    job_postings[]
}

model job_postings {
  id              Int           @id @default(autoincrement())
  source          String // any VALID_SOURCES board (src/lib/constants.ts, 11 watchlist-capable) or feed-only oracle | jobvite
  external_id     String // id returned by the board
  company_slug    String? // board slug this posting came from (for promotion grouping; null on legacy rows)
  company_name    String
  job_title       String
  location        String?
  job_url         String
  description     String // full JD text (fed to the LLM)
  score           Int? // 0-100 fit score (codex CLI default / claude alternate); screen verdicts are local (Ollama)
  score_detail    String? // JSON: { assessment:{seniority,domain,must_haves,nice_to_haves,summary}, screen, [disqualified,disqualification_reason], [recommended_resume] } (worker output; pre-S2.1 rows carry matched_keywords/missing_keywords/reasoning instead)
  pipeline_status String        @default("new") // new|scored|notified|applied|discarded|failed|removed|expired ('expired' = the board 404/410'd the listing; terminal, drops out of the live buckets like 'removed')
  pipeline_error  String? // last stage/send error (kept while a notify retry is pending; cleared on successful notify)
  attempts        Int           @default(0) // SCORE-stage failure count; failed rows requeue to 'new' (run_retry) while attempts < 3, else parked terminal
  notify_attempts Int           @default(0) // NOTIFY-stage send-failure count, kept separate so score hiccups can't pre-spend the delivery budget; a notify-exhausted row (>= 3) never requeues
  application_id  Int? // back-link once marked applied
  application     applications? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  created_at      String
  updated_at      String?
  posted_at       String? // board posting date normalized to YYYY-MM-DD; scrape-date fallback when the board gives none; null only on legacy pre-backfill rows
  deprioritized_at String? // set by the FREE seniority pre-ordering (score/seniority.py) when the JD states a bar this candidate does not clear: the row stays 'new' and searchable but sorts to the BACK of the score queue. NOT a discard -- the labels behind it are the strong scorer's verdicts, not human ones. Clearing the column un-demotes, row for row.

  @@unique([source, external_id]) // dedup key
  @@index([pipeline_status])
}

model status_history {
  id             Int          @id @default(autoincrement())
  application_id Int
  status         String
  timestamp      String
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id])
}

// The watchlist of companies the worker fetches in full, one board per row.
// DB-owned (not config.yaml) so the web UI can manage it and a future
// promotion-suggestion step can append to it. Seeded once from config.yaml's
// `companies:` when empty; thereafter this table is authoritative.
model watched_companies {
  id         Int    @id @default(autoincrement())
  source     String // one of VALID_SOURCES (src/lib/constants.ts) — the 11 watchlist-capable boards
  slug       String // board identifier (workday packs tenant/datacenter/site)
  name       String // display name
  recipe     String? // JSON recipe for source=custom|browser (declarative fetch); NULL for platform/known-ATS rows
  created_at String

  @@unique([source, slug]) // dedup key
}

// "Record fail instances for next step": feed listings whose apply URL the
// resolver could not map to a supported board+slug (workday deferred, embedded
// greenhouse without a slug, or an unsupported ATS host). A prioritised backlog
// for expanding feed coverage — written by the worker, not yet surfaced in the UI.
model feed_unresolved {
  id           Int     @id @default(autoincrement())
  feed         String // which feed surfaced it, e.g. "simplify"
  url          String // the unresolvable apply URL
  company_name String
  job_title    String
  host         String // parsed hostname, for prioritising (e.g. myworkdayjobs.com)
  reason       String // workday_deferred | embedded_greenhouse | unsupported_host | list_fetch_failed | detail_fetch_failed
  created_at   String
  updated_at   String?

  @@unique([url]) // upsert key — no pile-up across passes
  @@index([reason])
}

// Companies the user dismissed from the promotion-suggestion list (feed →
// watchlist). A dismissed (source, slug) is filtered out of future suggestions.
model promotion_dismissed {
  id         Int    @id @default(autoincrement())
  source     String
  slug       String
  created_at String

  @@unique([source, slug])
}

// Generic key-value store for web-app user preferences. Currently one row,
// key='categories', whose `value` is a JSON string array — the user-chosen
// application category vocabulary (see src/lib/actions.ts getCategories/setCategories).
// Web-only: the Python worker never reads this, but the schema-drift guard
// (tools/check_schema_drift.mjs) still requires it in the worker fixture.
model app_settings {
  key        String  @id
  value      String
  updated_at String?
}
