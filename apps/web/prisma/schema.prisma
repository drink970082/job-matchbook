generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Configurable so the same schema works in two places:
  //   - local dev / Prisma CLI: `file:./applications.db` (see .env) → the
  //     prisma/applications.db symlink to ../db/applications.db.
  //   - Docker: an absolute path on a DIRECTORY-mounted volume shared with the
  //     Python worker, e.g. `file:/data/applications.db`. The directory mount
  //     (not a single-file mount) is REQUIRED so SQLite's WAL -wal/-shm sidecar
  //     files are visible to both processes; otherwise cross-container WAL breaks.
  url      = env("DATABASE_URL")
}

model applications {
  id              Int              @id @default(autoincrement())
  company_name    String
  job_title       String
  application_url String?
  date_applied    String
  category        String?
  status          String
  notes           String?
  last_updated    String?
  actor           String           @default("web") // who created the row: web | mcp (lib/constants.ts ACTORS)
  status_history  status_history[]
  job_postings    job_postings[]
}

model job_postings {
  id              Int           @id @default(autoincrement())
  source          String // any VALID_SOURCES board (src/lib/constants.ts, 11 watchlist-capable) or feed-only oracle | jobvite
  external_id     String // id returned by the board
  company_slug    String? // board slug this posting came from (for promotion grouping; null on legacy rows)
  company_name    String
  job_title       String
  location        String?
  job_url         String
  description     String // full JD text (fed to the LLM)
  score_detail    String? // JSON: { assessment:{seniority,domain,must_haves,nice_to_haves,summary}, screen, [disqualified,disqualification_reason], [recommended_resume] } (worker output; pre-S2.1 rows carry matched_keywords/missing_keywords/reasoning instead)
  pipeline_status String        @default("new") // new|scored|notified|applied|discarded|failed|removed|expired ('expired' = the board 404/410'd the listing; terminal, drops out of the live buckets like 'removed')
  pipeline_error  String? // last stage/send error (kept while a notify retry is pending; cleared on successful notify)
  application_id  Int? // back-link once marked applied
  application     applications? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  job_screening   job_screenings?
  jev_assessment  job_jev_assessments?
  triage_override job_triage_overrides?
  created_at      String
  updated_at      String?
  posted_at       String? // board posting date normalized to YYYY-MM-DD; scrape-date fallback when the board gives none; null only on legacy pre-backfill rows
  source_state                    String  @default("unknown") // unknown | available | closed; independent of pipeline_status
  source_last_seen_at             String? // latest exact identity seen in a listing or detail response
  source_absent_count             Int     @default(0) // consecutive successful, non-empty board lists without this id; 3 closes it
  source_last_check_attempted_at  String? // latest selected detail refresh attempt
  source_last_checked_at          String? // latest conclusive exact-ID detail check
  source_last_check_outcome        String  @default("not_checked") // not_checked | found | confirmed_closed | inconclusive
  source_last_check_error_category String? // safe fixed category; never raw provider output
  source_content_hash              String? // SHA-256 over company/title/location/description
  source_content_revision           Int? // revision of those assessment inputs
  source_content_changed_at         String? // time the current assessment inputs were observed

  @@unique([source, external_id]) // dedup key
  @@index([pipeline_status])
  @@index([source, source_last_check_attempted_at])
}

// Latest standalone hard-requirements screen result. This lifecycle is separate from
// job_postings.pipeline_status and fit score_detail: screening can complete while a
// posting stays `new`, and provider failures remain visible for a later bounded retry.
model job_screenings {
  id                Int          @id @default(autoincrement())
  job_posting_id    Int          @unique
  state             String       // complete | provider_error
  result_json       String?      // nested screen result; null on provider error
  error_category    String?
  error_message     String?      // fixed sanitized summary; never provider output
  backend           String
  model             String?
  effort            String?
  evaluator_version String
  last_attempted_at String
  completed_at      String?
  source_content_revision Int? // posting content revision used by this completed screen
  created_at        String
  updated_at        String?
  job_posting       job_postings @relation(fields: [job_posting_id], references: [id], onDelete: Cascade)

  @@index([state, last_attempted_at])
}

// JEV keep/skip filter (worker `run_jev`). One latest assessment per posting; a skip
// only hides the row from the MCP default list, it never changes pipeline_status.
model job_jev_assessments {
  id                      Int          @id @default(autoincrement())
  job_posting_id          Int          @unique
  state                   String       // complete | provider_error
  verdict                 String?      // keep | skip; null on provider error
  reasons_json            String?      // JSON array of closed reason codes
  result_json             String?      // native answers of both questions
  error_category          String?
  model                   String?
  policy_sha256           String       // profile + question packs + model binding
  source_content_revision Int?
  cost_usd                String?
  last_attempted_at       String
  completed_at            String?
  created_at              String
  updated_at              String?
  job_posting             job_postings @relation(fields: [job_posting_id], references: [id], onDelete: Cascade)

  @@index([state, last_attempted_at])
}

// The operator's keep/skip over JEV's verdict (#155). Applies only while the posting's
// source_content_revision equals the one recorded here; JEV never writes this table.
// Set/clear are audited in audit_log (entity job_triage_overrides).
model job_triage_overrides {
  id                      Int          @id @default(autoincrement())
  job_posting_id          Int          @unique
  decision                String       // keep | skip
  reason                  String?
  actor                   String       // web | mcp
  source_content_revision Int?         // posting revision when set
  created_at              String
  job_posting             job_postings @relation(fields: [job_posting_id], references: [id], onDelete: Cascade)
}

model status_history {
  id             Int          @id @default(autoincrement())
  application_id Int
  status         String
  timestamp      String
  actor          String       @default("web") // who made the change: web | mcp
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id])
}

// The watchlist of companies the worker fetches in full, one board per row.
// DB-owned (not config.yaml) so the web UI can manage it and a future
// promotion-suggestion step can append to it. Seeded once from config.yaml's
// `companies:` when empty; thereafter this table is authoritative.
model watched_companies {
  id         Int    @id @default(autoincrement())
  source     String // one of VALID_SOURCES (src/lib/constants.ts) — the 11 watchlist-capable boards
  slug       String // board identifier (workday packs tenant/datacenter/site)
  name       String // display name
  recipe     String? // JSON recipe for source=custom|browser (declarative fetch); NULL for platform/known-ATS rows
  created_at String

  @@unique([source, slug]) // dedup key
}

// Append-only record of watchlist adds/removes (#156). A removal's payload is the
// full deleted row (JSON) so web can show it and offer a re-add. Web writes it; the
// worker never reads it.
model audit_log {
  id        Int    @id @default(autoincrement())
  at        String // ISO timestamp
  actor     String // web | mcp (lib/constants.ts ACTORS)
  action    String // add | remove
  entity    String // table name, e.g. watched_companies
  entity_id Int
  payload   String // JSON of the row as added / as it was before removal

  @@index([entity, id])
}

// "Record fail instances for next step": feed listings whose apply URL the
// resolver could not map to a supported board+slug (workday deferred, embedded
// greenhouse without a slug, or an unsupported ATS host). A prioritised backlog
// for expanding feed coverage — written by the worker, not yet surfaced in the UI.
model feed_unresolved {
  id           Int     @id @default(autoincrement())
  feed         String // which feed surfaced it, e.g. "simplify"
  url          String // the unresolvable apply URL
  company_name String
  job_title    String
  host         String // parsed hostname, for prioritising (e.g. myworkdayjobs.com)
  reason       String // workday_deferred | embedded_greenhouse | unsupported_host | list_fetch_failed | detail_fetch_failed
  created_at   String
  updated_at   String?

  @@unique([url]) // upsert key — no pile-up across passes
  @@index([reason])
}

// Generic key-value store for web-app user preferences. Currently one row,
// key='categories', whose `value` is a JSON string array — the user-chosen
// application category vocabulary (see src/lib/category-actions.ts getCategories/setCategories).
// Web-only: the Python worker never reads this, but the schema-drift guard
// (tools/check_schema_drift.mjs) still requires it in the worker fixture.
model app_settings {
  key        String  @id
  value      String
  updated_at String?
}

// The candidate's hard requirements (#157): one row, id=1, read by the worker's screen.
// Seeded once from config.yaml `candidate:` when absent; after that this row wins.
// `version` bumps on every change; `changed_at` is the last change after the seed
// (null = still the seeded values), so a screen completed before it is stale.
model candidate_preferences {
  id                  Int     @id
  highest_degree      String  @default("")
  work_authorization  String  @default("")
  security_clearance  String  @default("")
  locations           String  @default("[]") // JSON string array
  exclude_internships Boolean @default(false)
  exclude_contract    Boolean @default(false) // contract / part-time / temporary titles (#206)
  version             Int     @default(1)
  actor               String  // config | web | mcp
  changed_at          String?
  updated_at          String
}

// The JEV keep/skip filter's inputs (#157): one row, id=1. Seeded once from config
// `jev_dir` (texts exactly as read: the policy hash covers them); after that this row
// wins. A change bumps `version` and re-queues every in-window posting for JEV.
model jev_profile {
  id           Int     @id
  profile_text String  // profile-binding.json, verbatim
  c_pack       String  // question-pack.json (JSON text; seed/file only)
  yoe_pack     String  // yoe-pack.json (JSON text; seed/file only)
  yoe_context  String  // education/experience facts for the YOE question
  version      Int     @default(1)
  actor        String  // config | web | mcp
  changed_at   String?
  updated_at   String
}

// One row per worker pass (#247), written only by the worker. Inserted `running` at
// pass start, finalized `ok` at the end. A pass that dies stays `running` until the
// next pass (which holds the pass lock, so no other pass is live) marks it `failed`
// with error_category `abandoned`. Every row is kept.
model worker_runs {
  id             Int     @id @default(autoincrement())
  started_at     String
  finished_at    String? // null while running, and on an abandoned pass (death time unknown)
  status         String  // running | ok | failed
  error_category String? // closed: abandoned
  fetch_only     Boolean @default(false)
  jev_enabled    Boolean @default(false)
  config_json    String  // JSON: effective runtime config; never secrets
  counts_json    String  // JSON: per-stage tallies: fetch, feed, expire, screen, triage

  @@index([started_at])
}
