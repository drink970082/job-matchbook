# Copy to .env and fill in. Loaded by ats_worker.run.load_env.

# Ollama endpoint used for the hard-requirements screen (no cost, no rate limits).
OLLAMA_HOST=http://localhost:11434

# Optional overrides (defaults shown; see SPEC §7.1 / §12).
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_NUM_CTX=8192
# SCREEN_WORKERS=0          # concurrent screen calls; 0 = 1

# Hard-requirements screen backend: ollama (default, free, local) | codex |
# claude-code | api | none.
#   codex / claude-code  use your CLI subscription login (no key).
#   api                  any OpenAI-compatible endpoint (OpenAI, OpenRouter, Gemini,
#                        LM Studio, vLLM, ...). METERED for hosted vendors.
#   none                 deterministic gates only (location, internships); LOW RECALL
#                        on sponsorship (a 12-phrase substring list, ~2/11 recall).
# SCREEN_BACKEND=ollama

# Model override for the chosen backend (defaults: ollama qwen3.5:4b, codex
# gpt-5.6-luna; claude-code takes your CLI's default). REQUIRED for SCREEN_BACKEND=api.
# SCREEN_MODEL=

# SCREEN_BACKEND=api only. Base URL defaults to OpenAI; omit the key for a keyless
# local server. Examples: https://openrouter.ai/api/v1,
# https://generativelanguage.googleapis.com/v1beta/openai, http://localhost:1234/v1
# SCREEN_API_BASE_URL=https://api.openai.com/v1
# SCREEN_API_KEY=

# OpenRouter API key — used ONLY by the `--jev` keep/skip filter (metered; capped per
# pass by --jev-max-usd). Without it the JEV stage logs a line and is skipped.
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
