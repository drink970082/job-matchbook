# Copy to .env and fill in. Loaded by ats_worker.run.load_env.

# Anthropic API key — used only for the hard-requirements screen when
# SCREEN_BACKEND=claude-api (METERED). Not needed by the default (ollama), nor by the
# codex / claude-code backends (they use your CLI subscription login — no key).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Ollama endpoint used for the hard-requirements screen (no cost, no rate limits).
OLLAMA_HOST=http://localhost:11434

# Optional overrides (defaults shown; see SPEC §7.1 / §12).
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_NUM_CTX=8192
# SCREEN_WORKERS=0          # concurrent screen calls; 0 = 1

# Hard-requirements screen backend: ollama (default, free, local) | codex |
# claude-code | claude-api | openai-api | none.
# 'none' runs only the deterministic gates (location, internships) and is LOW RECALL
# on sponsorship — it falls back to a 12-phrase substring list (~2/11 recall).
# SCREEN_BACKEND=ollama

# Model override for whichever SCREEN_BACKEND is chosen (default is per-backend:
# ollama qwen3.5:4b, codex gpt-5.6-sol, claude-api claude-haiku-4-5,
# openai-api gpt-5.6-luna; claude-code has no hard-coded default — omitted, it takes
# whatever model your Claude Code CLI itself defaults to).
# SCREEN_MODEL=

# OpenAI API key — used ONLY when SCREEN_BACKEND=openai-api (metered).
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenRouter API key — used ONLY by the `--jev` keep/skip filter (metered; capped per
# pass by --jev-max-usd). Without it the JEV stage logs a line and is skipped.
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
