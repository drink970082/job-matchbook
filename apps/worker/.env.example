# Copy to .env and fill in. Loaded by ats_worker.run.load_env.

# Fit-score backend: codex (default) | claude.
#   codex  — the Codex CLI on your ChatGPT subscription: flat-rate, ~42s/posting.
#            Auth is NOT set here — run `codex login` on this host once and check
#            `codex doctor` (auth ✓). No key needed below.
#   claude — the metered Anthropic API; needs ANTHROPIC_API_KEY.
# SCORE_BACKEND=codex

# Anthropic API key — used for fit scoring ONLY when SCORE_BACKEND=claude.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot credentials for the human-in-the-loop match alert.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlmNoPQRstuVWxyz
TELEGRAM_CHAT_ID=123456789

# Ollama endpoint used for the hard-requirements screen (no cost, no rate limits).
OLLAMA_HOST=http://localhost:11434

# Optional overrides (defaults shown; see SPEC §7.1 / §12).
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_NUM_CTX=8192
# CODEX_SCORE_MODEL=gpt-5.6-sol
# ANTHROPIC_SCORE_MODEL=claude-sonnet-5
# CODEX_BATCH_SIZE=1        # postings per codex exec call; parked at 1 (SPEC §13)

# Hard-requirements screen backend: ollama (default, free, local) | codex |
# claude-code | claude-api | openai-api | none.
# 'none' runs only the deterministic gates (location, internships) and is LOW RECALL
# on sponsorship — it falls back to a 12-phrase substring list (~2/11 recall).
# SCREEN_BACKEND=ollama
