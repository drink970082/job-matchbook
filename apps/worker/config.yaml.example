# Worker configuration. Loaded by ats_worker.run at startup.
# Source must be one of: greenhouse, lever, ashby, workday, pinpoint,
# smartrecruiters, workable (the watchlist-capable boards). oracle and jobvite are
# feed-resolution-only (no board to enumerate), so they can't be watch-listed here.
# The `slug` is the board identifier in each board's URL. Most sources take a
# single token; workday is special (see comment below).

# NOTE: the watchlist now lives in the DB (table `watched_companies`), managed in
# the web app's Watchlist tab. This `companies:` list is a ONE-TIME SEED: it's
# imported into the DB on the first run when the watchlist is empty (or on demand
# via `python -m ats_worker.run --import-companies`). After seeding, edits here
# are ignored — add/remove companies in the web UI instead.
companies:
  - { source: greenhouse, slug: acme, name: "Acme Inc" }       # job-boards.greenhouse.io/{slug}
  - { source: lever, slug: foobar, name: "Foobar" }            # jobs.lever.co/{slug}
  # - { source: ashby, slug: example, name: "Example Co" }     # jobs.ashbyhq.com/{slug}
  # - { source: pinpoint, slug: acme, name: "Acme" }           # {slug}.pinpointhq.com/postings.json
  # - { source: smartrecruiters, slug: Acme, name: "Acme" }    # api.smartrecruiters.com/.../{slug}
  # - { source: workable, slug: acme, name: "Acme" }           # apply.workable.com/{slug}
  # Workday slug packs three parts as "tenant/datacenter/site" (from the board URL
  # {tenant}.{dc}.myworkdayjobs.com/{site}). Quote it because of the slashes:
  # - { source: workday, slug: "acme/wd5/External_Careers", name: "Acme" }

# OPTIONAL discovery feeds: a broad listing stream (a public GitHub data file —
# NOT a scraped board) whose apply URLs are resolved back to boards and fetched
# with the same adapters. Off by default. Only the SimplifyJobs new-grad feed is
# supported in v1; it resolves greenhouse (incl. EU), lever, ashby, workday,
# smartrecruiters, workable, oracle, and jobvite listings (~⅔ of the filtered feed)
# and records the rest (iCIMS, embedded greenhouse, bespoke ATSes) in
# `feed_unresolved` for a next step.
feeds:
  simplify:
    enabled: false              # set true to pull the feed each pass
    # Cheap keep-list applied to the feed's own `category` before any fetch/score
    # (drops Product/Hardware). Sponsorship/location are still judged by the LLM.
    categories: ["Software", "AI/ML/Data", "Quant"]
    # url: ""                   # optional override of the listings.json URL

# OPTIONAL coarse pre-filter, applied at fetch time BEFORE the LLM scorer. Keep a
# posting only if its TITLE contains ANY of these (case-insensitive substring).
# Title-only on purpose — matching the description would let almost every JD
# through. It exists only to avoid scoring obviously-irrelevant roles at high-volume
# companies; the scorer does the real relevance judging, so leave it empty unless a
# company floods you with off-target postings. Geography is NOT handled here — use
# candidate.locations below (the LLM understands a New York role satisfies "USA").
title_filter: []              # e.g. ["engineer", "developer"]

candidate:
  # Your HARD requirements — the ONLY things that DISQUALIFY (discard) a posting.
  # The LLM screens each field below pass/fail per posting (judged semantically, so
  # "no sponsorship" or "USA covers New York" work by meaning, not keyword match).
  # A missing skill/technology is NOT here — that only lowers the fit score; your
  # skills live in the résumé. EVERY field is optional — leave one blank to not
  # screen on it; leave everything blank to disable disqualification entirely.
  highest_degree: "Master's"          # none | High School | Associate | Bachelor's | Master's | PhD
  work_authorization: "needs visa sponsorship"   # citizen | permanent resident | authorized-no-sponsorship | needs visa sponsorship
  security_clearance: "none"          # none | confidential | secret | top secret
  locations: ["remote"]               # where you can actually work (on-site roles elsewhere are discarded)
  exclude_internships: true           # deterministic: discard intern/co-op roles by job title (no LLM)
  dealbreakers:                       # freeform extra HARD constraints the fields above don't cover
    - "requires an active US security clearance"   # example — delete or replace with your own

threshold: 75              # minimum Claude fit score (0-100) required to tailor
schedule_hours: 24         # cron interval for the background scheduler
max_single_page_rounds: 3  # max Claude retries to squeeze the resume to 1 page
