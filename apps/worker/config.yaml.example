# Worker configuration. Loaded by ats_worker.run at startup.
# Source must be one of: greenhouse, lever, ashby, workday, pinpoint,
# smartrecruiters, workable, icims, phenom, custom, browser (the watchlist-capable
# boards). oracle and jobvite are feed-resolution-only (no board to enumerate), so
# they can't be watch-listed here. The `slug` is the board identifier in each board's
# URL. Most sources take a single token; workday/phenom pack multiple parts, and
# custom/browser are recipe-driven (see below).

# NOTE: the watchlist now lives in the DB (table `watched_companies`), managed in
# the web app's Watchlist tab. This `companies:` list is a ONE-TIME SEED: it's
# imported into the DB on the first run when the watchlist is empty (or on demand
# via `python -m ats_worker.run --import-companies`). After seeding, edits here
# are ignored — add/remove companies in the web UI instead.
companies:
  - { source: greenhouse, slug: acme, name: "Acme Inc" }       # job-boards.greenhouse.io/{slug}
  - { source: lever, slug: foobar, name: "Foobar" }            # jobs.lever.co/{slug}
  # - { source: ashby, slug: example, name: "Example Co" }     # jobs.ashbyhq.com/{slug}
  # - { source: pinpoint, slug: acme, name: "Acme" }           # {slug}.pinpointhq.com/postings.json
  # - { source: smartrecruiters, slug: Acme, name: "Acme" }    # api.smartrecruiters.com/.../{slug}
  # - { source: workable, slug: acme, name: "Acme" }           # apply.workable.com/{slug}
  # Workday slug packs three parts as "tenant/datacenter/site" (from the board URL
  # {tenant}.{dc}.myworkdayjobs.com/{site}). Quote it because of the slashes:
  # - { source: workday, slug: "acme/wd5/External_Careers", name: "Acme" }
  # - { source: icims, slug: careers-sig, name: "SIG" }         # {slug}.icims.com (server HTML)
  # Phenom slug packs "{host}/{domain}":
  # - { source: phenom, slug: "apply.careers.microsoft.com/microsoft.com", name: "Microsoft" }
  # custom = plain-HTTP recipe (JSON / __NEXT_DATA__); the recipe names url/mode/fields:
  # - source: custom
  #   slug: amazon
  #   name: "Amazon"
  #   recipe:
  #     # The trailing `normalized_country_code[]` is a board-SIDE filter: amazon.jobs is
  #     # a faceted search API, so the non-matching rows are never fetched at all. Drop it
  #     # if you want postings outside the US. Measured 2026-08-01: 2,035 -> 1,267 rows
  #     # fetched, with an IDENTICAL set surviving the free deterministic gate (411
  #     # either way) -- it removes only rows the location gate discarded for free anyway.
  #     # Most boards cannot do this -- greenhouse and workday ignore location params
  #     # silently rather than rejecting them (docs/BACKLOG.md, the intake-cut entry).
  #     url: "https://www.amazon.jobs/en/search.json?base_query=software+engineer&normalized_country_code%5B%5D=USA"
  #     mode: json
  #     item_path: jobs
  #     total_path: hits
  #     page: { type: offset, param: offset, size_param: result_limit, size: 100 }
  #     fields:
  #       title: title
  #       location: normalized_location
  #       url: "https://www.amazon.jobs{job_path}"
  #       description: description
  #       posted_at: posted_date
  #       external_id: id_icims
  # browser = headless-Chromium recipe for boards plain HTTP can't fetch (needs the
  # Playwright extra + enable_browser_sources: true below):
  # - source: browser
  #   slug: citadelsecurities.com
  #   name: "Citadel Securities"
  #   recipe:
  #     url: "https://www.citadelsecurities.com/careers/open-opportunities/"
  #     item: "a.careers-listing-card"
  #     page: { type: url, template: "https://www.citadelsecurities.com/careers/open-opportunities/page/{n}/", start: 2 }
  #     fields:
  #       title: "h2"
  #       location: ".careers-listing-card__location"
  #       url: { attr: href }
  #       external_id: { attr: href, extract: "details/([^/]+)/" }
  #     detail: { url_field: job_url, fields: { description: ".single-job-post-description" } }

# OPTIONAL discovery feeds: a broad listing stream (a public GitHub data file —
# NOT a scraped board) whose apply URLs are resolved back to boards and fetched
# with the same adapters. Off by default. Only the SimplifyJobs new-grad feed is
# supported in v1; it resolves greenhouse (incl. EU), lever, ashby, workday,
# smartrecruiters, workable, oracle, and jobvite listings (~⅔ of the filtered feed)
# and records the rest (iCIMS, embedded greenhouse, bespoke ATSes) in
# `feed_unresolved` for a next step.
feeds:
  simplify:
    enabled: false              # set true to pull the feed each pass
    # Cheap keep-list applied to the feed's own `category` before any fetch/score
    # (drops Product/Hardware). Sponsorship/location are still judged by the LLM.
    # title_filter, title_exclude and max_age_days above apply here too, before any
    # URL resolve or detail fetch — the feed is the firehose, so they save the most.
    categories: ["Software", "AI/ML/Data", "Quant"]
    # url: ""                   # optional override of the listings.json URL

# OPTIONAL coarse pre-filter, applied at fetch time BEFORE the LLM scorer. Keep a
# posting only if its TITLE contains ANY of these (case-insensitive substring).
# Title-only on purpose — matching the description would let almost every JD
# through. It exists only to avoid scoring obviously-irrelevant roles at high-volume
# companies; the scorer does the real relevance judging, so leave it empty unless a
# company floods you with off-target postings. Geography is NOT handled here — use
# candidate.locations below (the LLM understands a New York role satisfies "USA").
title_filter: []              # e.g. ["engineer", "developer"]

# Optional negative title pre-filter: DROP a posting whose title carries any of these
# (case-insensitive), the complement of title_filter. Empty/omitted = drop none.
#
# NOTE the asymmetry with title_filter above: these match as WHOLE WORDS, not
# substrings. So they do not stem — "intern" will not reach "internship" (list both),
# and "robot" will not reach "robotics". In exchange, an exclude cannot over-reach:
# "intern" as a substring also ate "Internal Compute Frameworks" and "International
# Analyst", and an exclude that over-reaches is invisible, because the posting it
# wrongly dropped never appears anywhere for you to notice. Word matching is also what
# makes short tokens safe here — "sr" as a substring hits SRAM and SRE, "ios" hits BIOS.
title_exclude: [intern, internship, "co-op", sales, principal, staff, director]

# Optional fetch-time freshness gate: drop a posting whose posted_at is older than
# this many days before it is ever screened/scored. 0 or omitted = off. Boards that
# don't publish a date (posted_at null) are always kept.
max_age_days: 30

candidate:
  # Your HARD requirements — the ONLY things that DISQUALIFY (discard) a posting.
  # The LLM screens each field below pass/fail per posting (judged semantically, so
  # "no sponsorship" or "USA covers New York" work by meaning, not keyword match).
  # A missing skill/technology is NOT here — that only lowers the fit score; your
  # skills live in the résumé. EVERY field is optional — leave one blank to not
  # screen on it; leave everything blank to disable disqualification entirely.
  highest_degree: "Master's"          # none | High School | Associate | Bachelor's | Master's | PhD
  work_authorization: "needs visa sponsorship"   # citizen | permanent resident | authorized-no-sponsorship | needs visa sponsorship
  security_clearance: "none"          # none | confidential | secret | top secret
  locations: ["remote"]               # where you can actually work (on-site roles elsewhere are discarded)
  exclude_internships: true           # deterministic: discard intern/co-op roles by job title (no LLM)
  years_experience: 0                 # years of professional experience. NOT a screen
                                      # check and it can never discard a posting: it
                                      # feeds the FREE seniority pre-ordering, which
                                      # sends a posting stating a bar you don't clear to
                                      # the BACK of the score queue. 0 = new grad.

schedule_hours: 24         # hours between WALL-CLOCK passes (00:00, then every N).
                           # Must divide 24: 1, 2, 3, 4, 6, 8, 12, 24. Anything else
                           # is rejected at startup — a non-divisor would run TIGHTER
                           # than configured across midnight, and >24 would collapse
                           # to daily. The daemon runs no pass at launch; --run-now
                           # asks for one.

# OPTIONAL: enable `browser`-source rows (headless Chromium via the Playwright extra).
# Off by default so a normal run stays pure `requests` and never imports Playwright.
# Requires: pip install -r requirements-browser.txt && playwright install chromium
enable_browser_sources: false

# ---------------------------------------------------------------------------------
# OPTIONAL — FIT VOCABULARY. The closed list of concepts a job's duties are matched
# against. SHADOW ONLY today: nothing in the running pipeline reads it (the live fit
# score still works off resume/personal_profile.txt). It feeds the bounded-extraction
# experiment — `tools/extract_shadow.py` — and the rebuild plan under
# docs/superpowers/plans/. Omit the whole block and nothing changes.
#
# THE IDEA. Instead of showing a model your preferences and asking it to judge, you
# list the kinds of WORK that exist for you, and the model only says which ones each
# duty is about. Your ranking (`priority`), your dislikes (`kind: anti_target`) and the
# numbers stay in code and are never sent to the model.
#
# ONE WARNING BEFORE YOU START. Omitting this block is completely safe. Writing a
# MALFORMED one is not: it is validated by the same loader as the rest of this file, so
# a mistake here raises at startup and stops the WHOLE worker — fetch, screen and notify
# included, not just the shadow tool. Run `make doctor` after editing it.
#
# WRITING A DESCRIPTION: describe the work, never your opinion of it. No "target",
# "avoid", "tier 1", "I want" — if the model can read your preference out of the text,
# you have just moved the judgment back into the model.
#
# LIMITS: ids unique and stable (they are stored on every label), descriptions <= 600
# characters, an `anti_target` may not carry a `priority`, at least one target concept
# (or `allow_anti_target_only: true`), a warning at or past `warn_concepts` and a hard
# failure past `max_concepts`. Both are settable keys here; they default to 20 and 40.
# Fewer, well-separated concepts beat many overlapping ones — overlap is what makes the
# model flip between two names for one thing.
#fit_profile:
#  priority_levels:              # as many tiers as you want — nothing assumes a scale.
#                                # Required whenever you declare a target concept: every
#                                # `priority` below has to name one of these.
#    primary:   { rank: 1, bonus: 10 }
#    secondary: { rank: 2, bonus: 4 }
#    fallback:  { rank: 3, bonus: -6 }
#    none:      { rank: 99, bonus: -12 }   # the tier a duty matching NOTHING votes for
#  none_level: none
#  concepts:
#    - id: ml_platform
#      priority: primary
#      description: >
#        Building the infrastructure used to train, deploy, serve, evaluate or monitor
#        machine-learning models — pipelines, feature stores, serving and evaluation.
#    - id: backend_services
#      priority: secondary
#      description: >
#        Server-side application engineering: APIs, distributed services, data stores
#        and the systems behind a product.
#    - id: frontend_only
#      kind: anti_target          # no priority: an anti-target is not a low tier
#      description: >
#        Work whose deliverable is the client user interface — components, visual
#        styling and browser application development.
